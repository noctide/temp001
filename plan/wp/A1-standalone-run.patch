@@ -0,0 +1,29 @@
+// 单独运行一个模块时（tl.py run <模块>）后端告诉前端：装了哪些模块、底座是不是测试桩。
+// 拿不到（没连后端、高保真比对时）就当作全装、不显示横幅，页面与原型一致。
+import { useEffect, useState } from "react";
+
+export interface RunInfo {
+  modules: string[];
+  bases: "stub" | "real";
+}
+
+export async function fetchRunInfo(f: typeof fetch = fetch): Promise<RunInfo | null> {
+  try {
+    const r = await f("/api/platform/run-info");
+    if (!r.ok) return null;
+    const j = (await r.json()) as Partial<RunInfo>;
+    return Array.isArray(j.modules) && (j.bases === "stub" || j.bases === "real")
+      ? { modules: j.modules, bases: j.bases }
+      : null;
+  } catch {
+    return null;
+  }
+}
+
+export function useRunInfo(): RunInfo | null {
+  const [info, setInfo] = useState<RunInfo | null>(null);
+  useEffect(() => {
+    void fetchRunInfo().then(setInfo);
+  }, []);
+  return info;
+}

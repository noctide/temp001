diff --git a/ops/tools/run.py b/ops/tools/run.py
new file mode 100644
index 0000000..68bcd34
--- /dev/null
+++ b/ops/tools/run.py
@@ -0,0 +1,208 @@
+"""单独运行一个模块（2026-10-25 维护者定：每个功能单独做、单独跑通再合并；施工说明 plan/NEXT-standalone-run.md）。
+
+tl.py run <模块>            起后端（只装这个业务模块 + 底座 + 外壳）和前端开发服务器，浏览器只看到这个模块
+tl.py run <模块> --smoke    自动跑一遍（合并前的门禁）；结果写 plan/.last-run-<模块>.json
+"""
+
+from __future__ import annotations
+
+import json
+import os
+import signal
+import subprocess
+import sys
+import time
+from datetime import UTC, datetime
+from pathlib import Path
+from typing import Any
+
+import yaml
+
+ROOT = Path(__file__).resolve().parents[2]
+WEB = ROOT / "apps" / "web"
+BASES = ("access", "execution", "facilities", "shell")  # 与 apps/api/titanloom/main.py 同一份（smoke 里核对）
+
+
+def business_modules() -> dict[str, str]:
+    """项目名 → 模块名（projects.yaml 里有 module 的、不是底座与外壳的）。"""
+    data: dict[str, dict[str, Any] | None] = yaml.safe_load((ROOT / "projects.yaml").read_text(encoding="utf-8"))
+    out: dict[str, str] = {}
+    for proj, info in data.items():
+        mod = str((info or {}).get("module") or "")
+        if mod and mod not in BASES:
+            out[proj] = mod
+    return out
+
+
+def resolve(name: str) -> str:
+    """接受项目名或模块名（plugin-host / plugin_host 都行），返回模块名。"""
+    mods = business_modules()
+    if name in mods:
+        return mods[name]
+    if name in mods.values():
+        return name
+    raise SystemExit(f"没有业务模块 {name!r}；可以单独运行的：{', '.join(sorted(mods.values()))}")
+
+
+def _env(module: str, bases: str) -> dict[str, str]:
+    env = dict(os.environ)
+    env.update(
+        TITANLOOM_MODULES=module, TITANLOOM_BASES=bases, TITANLOOM_RUN="1", PYTHONUTF8="1", PYTHONIOENCODING="utf-8"
+    )
+    return env
+
+
+def _git_head() -> str:
+    r = subprocess.run(["git", "rev-parse", "--short", "HEAD"], cwd=ROOT, capture_output=True, text=True)
+    return r.stdout.strip() or "?"
+
+
+# ------------------------------------------------------------------ 开发运行
+def serve(module: str, bases: str, port: int) -> int:
+    vite = WEB / "node_modules" / ".bin" / ("vite.cmd" if os.name == "nt" else "vite")
+    if not vite.exists():
+        print("前端依赖没装：先在仓库根运行 pnpm install", file=sys.stderr)
+        return 2
+    env = _env(module, bases) | {"TL_API_PORT": str(port)}  # 前端开发服务器把 /api 转到这个端口
+    api = subprocess.Popen(
+        [sys.executable, "-m", "uvicorn", "titanloom.main:create_app", "--factory", "--port", str(port), "--reload"],
+        cwd=ROOT,
+        env=env,
+    )
+    web = subprocess.Popen([str(vite), "--port", "5173", "--strictPort"], cwd=WEB, env=env)
+    print(f"\n只运行「{module}」：后端 http://127.0.0.1:{port}/api/docs · 前端 http://127.0.0.1:5173/")
+    print("  换人：地址后加 ?role=lead（刘畅·部门负责人）/ member（王磊）/ zym（赵一鸣·表单管理员）")
+    if bases == "stub":
+        print("  注意：底座是测试桩，数据只在内存里，重启就没了（真实实现做完后默认改为真库）")
+    print("  按 Ctrl+C 停止\n")
+    try:
+        while api.poll() is None and web.poll() is None:
+            time.sleep(0.5)
+    except KeyboardInterrupt:
+        pass
+    finally:
+        for p in (web, api):
+            if p.poll() is None:
+                p.send_signal(signal.CTRL_BREAK_EVENT if os.name == "nt" else signal.SIGINT)  # pyright: ignore[reportAttributeAccessIssue]
+                try:
+                    p.wait(10)
+                except subprocess.TimeoutExpired:
+                    p.kill()
+    return 0
+
+
+# ------------------------------------------------------------------ smoke（合并门禁）
+SMOKE_PY = r"""
+import importlib, json, sys
+from fastapi.testclient import TestClient
+from titanloom import main
+mod = sys.argv[1]
+out = []
+def ok(name, detail=""): out.append({"name": name, "ok": True, "detail": detail})
+def bad(name, detail): out.append({"name": name, "ok": False, "detail": detail})
+assert tuple(main.BASES) == tuple(json.loads(sys.argv[2])), "ops/tools/run.py 与 main.py 的底座清单不一致"
+app = main.create_app([mod])
+try:
+    c = TestClient(app)
+    r = c.get("/api/health")
+    (ok if r.status_code == 200 else bad)("健康检查", f"HTTP {r.status_code}")
+    info = c.get("/api/platform/run-info").json()
+    (ok if info["modules"] == [mod] else bad)("只装了这个模块", json.dumps(info, ensure_ascii=False))
+    others = [m for m in main.business_modules() if m != mod]
+    leaked = [p for p in c.get("/api/openapi.json").json()["paths"] if any(p.startswith(f"/api/{o}/") for o in others)]
+    (bad("没有混进别的模块的接口", ", ".join(leaked)) if leaked else ok("没有混进别的模块的接口"))
+    try:
+        sm = importlib.import_module(f"titanloom.{mod}.dev.smoke")
+    except ModuleNotFoundError as e:
+        want = f"titanloom.{mod}.dev.smoke"
+        if not (e.name and (want == e.name or want.startswith(e.name + "."))):
+            raise
+        ok("模块自己的冒烟检查", f"还没有 titanloom/{mod}/dev/smoke.py（有接口以后要写）")
+    else:
+        try:
+            sm.smoke(c)
+            ok("模块自己的冒烟检查", f"titanloom/{mod}/dev/smoke.py")
+        except Exception as e:  # noqa: BLE001
+            bad("模块自己的冒烟检查", f"{type(e).__name__}: {e}")
+finally:
+    app.state.restore_bases()
+print("@@RESULT@@" + json.dumps(out, ensure_ascii=False))
+"""
+
+
+def smoke(module: str, bases: str) -> int:
+    started = time.time()
+    steps: list[dict[str, Any]] = []
+    env = _env(module, bases)
+    r = subprocess.run(
+        [sys.executable, "-c", SMOKE_PY, module, json.dumps(BASES)],
+        cwd=ROOT,
+        env=env,
+        capture_output=True,
+        text=True,
+        encoding="utf-8",
+    )
+    marker = [ln for ln in r.stdout.splitlines() if ln.startswith("@@RESULT@@")]
+    if marker:
+        steps += json.loads(marker[-1][len("@@RESULT@@") :])
+    else:
+        steps.append({"name": "后端启动", "ok": False, "detail": (r.stderr or r.stdout).strip()[-1500:]})
+    # 前端：这个模块的领域目录 + 外壳的测试（导航只显示装了的模块）
+    vitest = WEB / "node_modules" / ".bin" / ("vitest.cmd" if os.name == "nt" else "vitest")
+    if vitest.exists():
+        targets = [f"src/domains/{module}", "src/shell"]
+        v = subprocess.run(
+            [str(vitest), "run", "--passWithNoTests", *targets],
+            cwd=WEB,
+            capture_output=True,
+            text=True,
+            encoding="utf-8",
+            env=env,
+        )
+        tail = [ln.strip() for ln in v.stdout.splitlines() if "Tests" in ln or "Test Files" in ln]
+        if v.returncode and "MODULE_NOT_FOUND" in (
+            v.stdout + v.stderr
+        ):  # 依赖是另一个系统装的（如 Windows 装、这里是 Linux）
+            steps.append(
+                {
+                    "name": "前端测试（本模块 + 外壳）",
+                    "ok": None,
+                    "detail": "前端依赖是另一个系统装的，跳过；在装依赖的那台机器上跑",
+                }
+            )
+        else:
+            steps.append(
+                {
+                    "name": "前端测试（本模块 + 外壳）",
+                    "ok": v.returncode == 0,
+                    "detail": " · ".join(tail) or v.stderr[-800:],
+                }
+            )
+    else:
+        steps.append({"name": "前端测试（本模块 + 外壳）", "ok": None, "detail": "没装前端依赖，跳过（pnpm install）"})
+    passed = all(s["ok"] is not False for s in steps)
+    result = {
+        "module": module,
+        "bases": bases,
+        "commit": _git_head(),
+        "at": datetime.now(UTC).strftime("%Y-%m-%d %H:%M UTC"),
+        "seconds": round(time.time() - started, 1),
+        "passed": passed,
+        "steps": steps,
+    }
+    (ROOT / "plan" / f".last-run-{module}.json").write_text(
+        json.dumps(result, ensure_ascii=False, indent=2), encoding="utf-8"
+    )
+    print(f"单独运行冒烟检查 · {module} · 底座 {bases} · 提交 {result['commit']}")
+    for s in steps:
+        mark = {True: "✓", False: "✗", None: "!"}[s["ok"]]
+        print(f"{mark} {s['name']}" + (f" —— {s['detail']}" if s["detail"] else ""))
+    if bases == "stub":
+        print("! 底座是测试桩（真实实现做完后改为真库再跑一遍）")
+    print("\n通过" if passed else "\n没通过：修好再报告 / 合并")
+    return 0 if passed else 1
+
+
+def main(name: str, do_smoke: bool, bases: str, port: int) -> int:
+    module = resolve(name)
+    return smoke(module, bases) if do_smoke else serve(module, bases, port)
